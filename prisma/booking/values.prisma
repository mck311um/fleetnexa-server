model Values {
  id                   String        @id @default(dbgenerated("gen_random_uuid()"))
  numberOfDays         Int
  basePrice            Float
  totalCost            Float
  discount             Float
  deliveryFee          Float
  collectionFee        Float
  deposit              Float?
  totalExtras          Float
  totalCharges         Float         @default(0.0)
  subTotal             Float         @default(0.0)
  netTotal             Float         @default(0.0)
  rentalId             String        @unique
  additionalDriverFees Float         @default(0.0)
  cancellationFee      Float         @default(0.0)
  lateFee              Float         @default(0.0)
  discountAmount       Float         @default(0.0)
  discountPolicy       String?

  customBasePrice      Boolean       @default(false)
  customCollectionFee  Boolean       @default(false)
  customDeliveryFee    Boolean       @default(false)
  customDiscount       Boolean       @default(false)
  customTotalCost      Boolean       @default(false)

  createdAt            DateTime      @default(now())
  updatedAt            DateTime?     @updatedAt

  extras               RentalExtra[]
  charges              RentalCharge[]

  rental               Rental        @relation(fields: [rentalId], references: [id])
}

model SecurityDeposit {
  id                String                  @id @default(dbgenerated("gen_random_uuid()"))
  bookingId         String                  @unique
  amount            Float
  amountCollected   Float                   @default(0.0)
  amountForfeited   Float                   @default(0.0)
  amountRefunded    Float                   @default(0.0)
  status            SecurityDepositStatus   @default(PENDING)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime?               @updatedAt
  updatedBy         String

  booking           Rental                  @relation(fields: [bookingId], references: [id])
  user              User                    @relation(fields: [updatedBy], references: [username])

  transactions      SecurityDepositTransaction[]
}

model SecurityDepositTransaction {
  id                String @id @default(dbgenerated("gen_random_uuid()"))
  securityDepositId String
  type              SecurityDepositTransactionType
  amount            Float
  notes             String?

  createdAt         DateTime @default(now())
  createdBy         String

  securityDeposit   SecurityDeposit @relation(fields: [securityDepositId], references: [id])
  user              User            @relation(fields: [createdBy], references: [username])
}